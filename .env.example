# Copy to .env and fill in. Shared by turbo's globalDependencies — Prisma
# and any app that reads process.env directly will pick this up when run
# from the repo root, but each app also has its own .env.example for when
# you run it standalone.

# --- Database ---
DATABASE_URL="postgresql://orgsites:orgsites@localhost:5432/orgsites"

# --- Redis (BullMQ) ---
REDIS_HOST="localhost"
REDIS_PORT="6379"

# --- Object storage (MinIO locally; swap for R2/S3 in staging+) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="orgsites"
S3_SECRET_KEY="orgsites123"
S3_BUCKET="orgsites-media"

# --- Payments ---
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# --- Transactional email ---
RESEND_API_KEY=""

# --- Renderer / domains ---
ORGSITES_ROOT_DOMAIN="orgsites.app"
REVALIDATE_SECRET="dev-secret-change-me"
RENDERER_REVALIDATE_URL="http://localhost:3001/api/revalidate"

# --- API ---
API_PORT="4000"
