# Renderer app (Next.js) — public site rendering.
DATABASE_URL="postgresql://orgsites:orgsites@localhost:5432/orgsites"
ORGSITES_ROOT_DOMAIN="orgsites.app"
# Marketing/builder URL linked by the always-on brand bar. Defaults to
# http://localhost:3000 in local dev; set to your hosted app in production.
ORGSITES_BRAND_URL="http://localhost:3000"
REVALIDATE_SECRET="dev-secret-change-me"
