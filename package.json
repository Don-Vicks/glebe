{
  "name": "orgsites",
  "private": true,
  "version": "0.1.0",
  "description": "OrgSites — website creation SaaS for NGOs, faith-based orgs, schools and civic institutions.",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @orgsites/api dev",
    "dev:builder": "pnpm --filter @orgsites/builder dev",
    "dev:renderer": "pnpm --filter @orgsites/renderer dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @orgsites/db generate",
    "db:migrate": "pnpm --filter @orgsites/db migrate",
    "db:studio": "pnpm --filter @orgsites/db studio",
    "db:seed": "pnpm --filter @orgsites/db seed",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^8.57.0"
  }
}
